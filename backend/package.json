{
  "name": "@tagum-pickleball/backend",
  "version": "1.0.0",
  "description": "Express backend for Tagum Pickleball Finder",
  "main": "dist/index.js",
  "scripts": {
    "dev": "set \"NODE_OPTIONS=--use-system-ca\"&& ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist/tests/paddleQ/rotationEngine.test.js dist/tests/paddleQ/paddleQService.test.js dist/tests/paddleQ/paddleQApi.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "playwright": "^1.41.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
